---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<Layout title="Windsurf About | Arturo Bevilacqua">
  <div class="page-shell windsurf-shell">
    <SiteHeader current="/windsurfing/about" />

    <main class="content-page">
      <section class="page-intro panel">
        <p class="section-kicker">About</p>
        <h1>A sailor, a teacher, and a seeker of clean lines.</h1>
      </section>

      <section class="story-grid panel">
        <div class="story-copy">
          <p>
            I spend a lot of my time on the water, teaching and practicing windsurfing and wingfoiling. I enjoy helping people feel confident, understanding how the wind works, and moving with it rather than against it.
          </p>
          <p>
            The same mindset applies off the water: I like structure, clarity, and learning by doing. Whether I’m coaching a beginner or refining a technique, I care about building calm confidence and reading the environment well.
          </p>
        </div>

        <div class="story-visual">
          <div class="mini-panel">
            <p class="section-kicker">What I’m about</p>
            <ul class="detail-list">
              <li>Reading the wind and the water</li>
              <li>Teaching with calm confidence</li>
              <li>Helping people progress safely and enjoyably</li>
              <li>Chasing the best conditions and the best line</li>
            </ul>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
