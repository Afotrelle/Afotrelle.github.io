---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<Layout title="Windsurf Contact | Arturo Bevilacqua">
  <div class="page-shell windsurf-shell">
    <SiteHeader current="/windsurfing/contact" />

    <main class="content-page">
      <section class="page-intro panel">
        <p class="section-kicker">Get in touch</p>
        <h1>Come surfing!</h1>
        <p class="lead">
            I'm focusing on my career as a researcher and won't be teaching windsurf/wingfoil anytime soon. 
            If you're looking to learn watersports I suggest booking a lesson with one of the following schools, they are very cool and professional! ;)
        </p>
      </section>

      <section class="contact-panel panel">
        <div class="contact-card">
          <a href="https://sites.google.com/view/www-avwmj-it/chi-siamo" target="_blank" rel="noreferrer">AVWMJ (Monfalcone, Friuli Venezia Giulia)</a>
          <a href="https://www.bluezonesardinia.eu/" target="_blank" rel="noreferrer">Bluezone Sardinia (Vignola Mare, Sardinia)</a>
        </div>
      </section>
    </main>
  </div>
</Layout>
