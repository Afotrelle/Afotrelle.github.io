---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const sessions = (await getCollection('sessions')).sort(
  (a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf(),
);

const formatDate = (value: string | Date) => {
  const date = value instanceof Date ? value : new Date(value);
  const day = String(date.getDate()).padStart(2, '0');
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const year = date.getFullYear();

  return `${day}/${month}/${year}`;
};
---

<Layout title="Sessions | Arturo Bevilacqua">
  <div class="page-shell windsurf-shell">
    <SiteHeader current="/windsurfing/sessions" />

    <main class="content-page">
      <section class="page-intro panel">
        <p class="section-kicker">Sessions</p>
        <h1>Windy days, events and friends</h1>
      </section>

      <div class="article-list">
        {sessions.map((session) => (
          <article class="article-preview panel">
            <div class="project-meta">{formatDate(session.data.publishedAt)} • {session.data.type}</div>
            <h2>
              <a href={`/windsurfing/sessions/${session.slug}`}>{session.data.title}</a>
            </h2>
            <p>{session.data.summary}</p>
            <a class="read-link" href={`/windsurfing/sessions/${session.slug}`}>Read more →</a>
          </article>
        ))}
      </div>
    </main>
  </div>
</Layout>
