---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout title="Contact | Arturo Bevilacqua">
  <div class="page-shell">
    <SiteHeader current="/contact" />

    <main class="content-page">
      <section class="page-intro panel">
        <p class="section-kicker">Contact</p>
        <h1>Contact me!</h1>
        <p class="lead">
          I'm currently looking for open positions in the Data Science and Machine Learning fields.
        </p>
        
      </section>

      <section class="contact-panel panel">
        <div class="contact-card">
          <a href="mailto:arti.bevilacqua@gmail.com">arti.bevilacqua@gmail.com</a>
          <a href="https://www.linkedin.com/in/arturo-bevilacqua-ba0875209/" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </section>
    </main>
  </div>
</Layout>
