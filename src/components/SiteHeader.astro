---
import WindsurfToggle from './WindsurfToggle.tsx';

const isWindsurfMode = Astro.url.pathname.replace(/^\/it(?=\/|$)/, '').startsWith('/windsurfing');
const isItalian = Astro.url.pathname === '/it' || Astro.url.pathname.startsWith('/it/');
const localePrefix = isItalian ? '/it' : '';
const navItems = !isWindsurfMode
  ? [
      { label: 'Home', href: `${localePrefix}/` },
      { label: isItalian ? 'Progetti' : 'Projects', href: `${localePrefix}/projects` },
      { label: isItalian ? 'CV' : 'CV', href: `${localePrefix}/cv` },
      { label: isItalian ? 'Contatti' : 'Contact', href: `${localePrefix}/contact` },
    ]
  : [];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeHref = isWindsurfMode ? `${localePrefix}/windsurfing` : `${localePrefix}/`;
const normalizedHomeHref = homeHref.replace(/\/$/, '') || '/';
const englishPath = Astro.url.pathname.replace(/^\/it(?=\/|$)/, '') || '/';
const italianPath = `/it${englishPath === '/' ? '/' : englishPath}`;
---

<header class="site-header">
  <div class="brand-wrap">
    <a href={homeHref} class="brand-name">Arturo Bevilacqua</a>
    <WindsurfToggle
      client:load
      label={isWindsurfMode ? '🤖' : '🌊'}
    />
  </div>

  <nav class="top-nav" aria-label={isItalian ? 'Navigazione principale' : 'Main navigation'}>
    {navItems.map((item) => {
      const normalizedHref = item.href.replace(/\/$/, '') || '/';
      const isActive = normalizedHref === normalizedHomeHref ? pathname === normalizedHomeHref : pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`);

      return (
        <a href={item.href} class:list={[{ 'is-active': isActive }]} aria-current={isActive ? 'page' : undefined}>
          {item.label}
        </a>
      );
    })}

    <a
      class="language-switch"
      href={isItalian ? englishPath : italianPath}
      lang={isItalian ? 'en' : 'it'}
      aria-label={isItalian ? 'Switch to English' : 'Passa all’italiano'}
      title={isItalian ? 'Switch to English' : 'Passa all’italiano'}
    >
      {isItalian ? '🇬🇧' : '🇮🇹'}
    </a>
  </nav>
</header>
